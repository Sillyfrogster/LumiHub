PORT=8080
SITE_URL=http://localhost:3000
DATABASE_URL=postgres://aaron@localhost:5432/lumihub_dev
UPLOADS_DIR=./uploads
TEST_DATABASE_URL=postgres://aaron@localhost:5432/lumihub_test

# Leave these empty in development to print verification links in the API log.
SMTP_ADDR=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Register this callback in a Discord application.
# http://localhost:3000/api/v1/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The largest upload the server will take, in bytes. Leave it out for 55 MB.
MAX_UPLOAD_BYTES=57671680
