PORT=8080
# The nginx front door, which serves the site, the API, media and downloads.
SITE_URL=http://localhost:8000
DATABASE_URL=postgres://aaron@localhost:5432/illarin_dev
UPLOADS_DIR=./uploads
TEST_DATABASE_URL=postgres://aaron@localhost:5432/illarin_test

# Generate 32 random bytes and encode them as unpadded base64url.
LINKING_HMAC_KEY=

# Leave these empty in development to print verification links in the API log.
# Production uses Microsoft Graph with the Mail.Send application permission.
MICROSOFT_365_TENANT_ID=
MICROSOFT_365_CLIENT_ID=
MICROSOFT_365_CLIENT_SECRET_FILE=
MICROSOFT_365_MAILBOX=

# SMTP fallback.
SMTP_ADDR=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Register this callback in a Discord application.
# http://localhost:3000/api/v1/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Ingest limits. These are the settled defaults.
MAX_UPLOAD_BYTES=33554432
MAX_ARCHIVE_ENTRIES=512
MAX_ARCHIVE_ENTRY_BYTES=33554432
MAX_ARCHIVE_BYTES=134217728
MAX_ARCHIVE_COMPRESSION_RATIO=100
INGEST_WORKERS=2

# Storage safety. Ingest keeps the reserve plus room for its largest write.
STORAGE_FREE_SPACE_RESERVE_BYTES=5368709120
ACCOUNT_STORAGE_CAP_BYTES=1073741824
