    "openapi-fetch": "^0.17.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@redocly/openapi-core": "1.34.19",
    "@biomejs/biome": "2.4.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
